# compose.yaml использует DB_PASSWORD; остальные значения нужны
# для backend вне Compose либо явного environment override.
DB_PASSWORD=queue-local-development
APP_ENV=demo
DATABASE_URL=postgresql+psycopg://queue:queue-local-development@localhost:5432/queue
DATA_DIR=runtime-data
TIMEZONE=Europe/Podgorica
ORIGIN=http://localhost:5173
DOCUMENT_READER=tesseract
PHOTO_RETENTION_HOURS=24
BOOKING_HORIZON_DAYS=7
FUTURE_SERVICE_LIMIT=true
ENFORCE_HOURS=false
RECALL_INTERVAL_SECONDS=120
# В demo ключи генерирует seed в закрытом data volume.
SESSION_SECRET=
ENCRYPTION_KEY=
FINGERPRINT_KEY=
STAFF_PASSWORD=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
RECORD_RETENTION_DAYS=0
