            "type": "string",
            "title": "Day Id"
          },
          "companion": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Companion",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "day_id"
        ],
        "title": "Booking"
      },
      "Call": {
        "properties": {
